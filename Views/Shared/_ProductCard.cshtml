@* Họ và tên: Phạm Văn Cường - MSSV: 23103100094
   Nội dung thực hiện: Thẻ hiển thị sản phẩm và trạng thái đặt mua (Module 2). *@
@model SanPham
@using System.Globalization
@{
    var available = Model.TrangThai == TrangThaiSanPham.DangKinhDoanh && Model.SoLuong > 0;
    var unavailableText = Model.TrangThai switch
    {
        TrangThaiSanPham.TamNgung => "Tạm ngừng bán",
        TrangThaiSanPham.NgungKinhDoanh => "Ngừng kinh doanh",
        _ => "Tạm hết hàng"
    };
    var image = string.IsNullOrWhiteSpace(Model.HinhAnh) ? Url.Content("~/images/product-placeholder.svg") : Model.HinhAnh;
}
<article class="product-card">
    <a class="product-image" asp-controller="SanPham" asp-action="Details" asp-route-id="@Model.MaSanPham" asp-route-view="store">
        <img src="@image" alt="@Model.TenSanPham" loading="lazy" data-product-image />
        <span class="product-brand">@Model.ThuongHieu</span>
        @if (!available) { <span class="product-stock sold-out">@unavailableText</span> }
    </a>
    <div class="product-card-content">
        <span class="product-category">@Model.LoaiSanPham?.TenLoai</span>
        <h3><a asp-controller="SanPham" asp-action="Details" asp-route-id="@Model.MaSanPham" asp-route-view="store">@Model.TenSanPham</a></h3>
        <span class="product-warranty"><svg class="icon"><use href="#i-shield" /></svg>Bảo hành @Model.ThoiGianBaoHanh tháng</span>
        <div class="product-card-bottom">
            <strong class="product-price">@Model.Gia.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) <small>₫</small></strong>
            <form asp-controller="GioHang" asp-action="ThemVaoGio" method="post" class="product-card-purchase" data-cart-form>
                <input type="hidden" name="maSanPham" value="@Model.MaSanPham" />
                <input type="hidden" name="soLuong" value="1" />
                <div class="product-card-actions">
                    <button class="btn btn-outline-primary product-card-action" type="submit" disabled="@(!available)" data-ajax-cart-submit>
                        <svg class="icon"><use href="#i-cart" /></svg> Thêm vào giỏ hàng
                    </button>
                    <button class="btn btn-primary product-card-action" type="submit" name="muaNgay" value="true" disabled="@(!available)">
                        Mua hàng
                    </button>
                </div>
            </form>
        </div>
    </div>
</article>
