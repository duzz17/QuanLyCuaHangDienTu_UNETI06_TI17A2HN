@* Khung giao diện dùng chung; giữ Session, phân quyền menu và thông báo của các module cũ. *@
@{
    var role = Context.Session.GetString("VaiTro");
    var name = Context.Session.GetString("HoTen");
    if (string.IsNullOrWhiteSpace(name)) name = "Khách hàng";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var adminArea = role == "Admin" && ViewData["Storefront"] is not true && Context.Request.Query["view"] != "store";
    var cartCount = 0;
    var cartJson = Context.Session.GetString("GIO_HANG_SESSION");
    if (!string.IsNullOrEmpty(cartJson))
    {
        try { cartCount = System.Text.Json.JsonSerializer.Deserialize<List<CartItemViewModel>>(cartJson)?.Sum(i => i.SoLuong) ?? 0; }
        catch (System.Text.Json.JsonException) { }
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#16352f" />
    <title>@ViewData["Title"] · Điện tử UNETI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(adminArea ? "admin-body" : "store-body")">
    <partial name="_Icons" />
    <a class="skip-link" href="#main-content">Chuyển đến nội dung</a>
    @if (adminArea)
    {
        <button type="button" class="sidebar-backdrop" data-close-sidebar aria-label="Đóng menu">
</button>
        <aside class="admin-sidebar" id="admin-sidebar" aria-label="Điều hướng quản trị">
            <a class="brand brand-light" asp-controller="Dashboard" asp-action="Index">
<span class="brand-mark">u<span>.</span>
</span>
<span>UNETI<span class="brand-caption">ĐIỆN TỬ & CÔNG NGHỆ</span>
</span>
</a>
            <div class="workspace-label">
<span class="online-dot">
</span> Không gian quản trị</div>
            <span class="nav-section-label">QUẢN LÝ CỬA HÀNG</span>
            <nav class="admin-nav">
                <a class="@(controller == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
<svg class="icon">
<use href="#i-grid"/>
</svg>Tổng quan</a>
                <a class="@(controller == "SanPham" ? "active" : "")" asp-controller="SanPham" asp-action="Index">
<svg class="icon">
<use href="#i-box"/>
</svg>Sản phẩm</a>
                <a class="@(controller == "LoaiSanPham" ? "active" : "")" asp-controller="LoaiSanPham" asp-action="Index">
<svg class="icon">
<use href="#i-tag"/>
</svg>Danh mục sản phẩm</a>
                <a class="@(controller == "DonHang" ? "active" : "")" asp-controller="DonHang" asp-action="Index">
<svg class="icon">
<use href="#i-bag"/>
</svg>Đơn hàng</a>
                <a class="@(controller == "KhachHang" ? "active" : "")" asp-controller="KhachHang" asp-action="Index">
<svg class="icon">
<use href="#i-users"/>
</svg>Khách hàng</a>
            </nav>
            <span class="nav-section-label">TÀI KHOẢN</span>
            <nav class="admin-nav">
                <a asp-controller="KhachHang" asp-action="HoSo">
<svg class="icon">
<use href="#i-user"/>
</svg>Hồ sơ cá nhân</a>
                <a asp-controller="Home" asp-action="Index" asp-route-view="store">
<svg class="icon">
<use href="#i-eye"/>
</svg>Xem cửa hàng<svg class="icon nav-arrow">
<use href="#i-arrow"/>
</svg>
</a>
            </nav>
            <div class="sidebar-bottom">
<div class="sidebar-user">
<span class="avatar">@name[..1].ToUpper()</span>
<div>
<strong>@name</strong>
<span>Quản trị viên</span>
</div>
</div>
<a asp-controller="TaiKhoan" asp-action="Logout">
<svg class="icon">
<use href="#i-logout"/>
</svg> Đăng xuất</a>
</div>
        </aside>
        <div class="admin-workspace">
            <header class="admin-topbar">
                <div class="d-flex align-items-center gap-3">
<button class="icon-button mobile-menu" type="button" data-toggle-sidebar aria-controls="admin-sidebar" aria-expanded="false" aria-label="Mở menu quản trị">
<svg class="icon">
<use href="#i-menu"/>
</svg>
</button>
<span class="topbar-breadcrumb">Cửa hàng <span>/</span> <strong>@ViewData["Title"]</strong>
</span>
</div>
                <div class="topbar-right">
<span class="system-status">
<span class="online-dot">
</span> Quản trị cửa hàng</span>
<a class="avatar" asp-controller="KhachHang" asp-action="HoSo" aria-label="Hồ sơ cá nhân">@name[..1].ToUpper()</a>
</div>
            </header>
            <main id="main-content" class="admin-main" tabindex="-1">
<partial name="_Messages" />@RenderBody()</main>
            <footer class="admin-footer">© @DateTime.Now.Year Điện tử UNETI <span>Hệ thống quản lý cửa hàng · Nhóm 6</span>
</footer>
        </div>
    }
    else
    {
        <div class="store-announcement">
<span>Công nghệ cho công việc. Cảm hứng cho cuộc sống.</span>
<span class="announcement-right">Điện tử UNETI · Nhóm 6</span>
</div>
        <header class="store-header">
            <div class="store-container store-header-inner">
                <a class="brand" asp-controller="Home" asp-action="Index" asp-route-view="store">
<span class="brand-mark">u<span>.</span>
</span>
<span>UNETI<span class="brand-caption">ĐIỆN TỬ & CÔNG NGHỆ</span>
</span>
</a>
                <form asp-controller="SanPham" asp-action="Index" method="get" class="header-search" role="search">
<input type="hidden" name="view" value="store"/>
<svg class="icon">
<use href="#i-search"/>
</svg>
<input name="tuKhoa" value="@Context.Request.Query["tuKhoa"]" placeholder="Bạn đang tìm sản phẩm nào?" aria-label="Tìm sản phẩm"/>
<button type="submit" aria-label="Tìm kiếm">
<svg class="icon">
<use href="#i-arrow"/>
</svg>
</button>
</form>
                <div class="header-actions">
                    @if (!string.IsNullOrEmpty(role))
                    {
                        <div class="dropdown">
                            <button type="button" class="account-button" data-bs-toggle="dropdown" aria-expanded="false">
<svg class="icon">
<use href="#i-user"/>
</svg>
<span>
<small>Tài khoản</small>
<strong>@name</strong>
</span>
</button>
                            <ul class="dropdown-menu dropdown-menu-end">
<li>
<a class="dropdown-item" asp-controller="KhachHang" asp-action="HoSo" asp-route-view="store">Hồ sơ cá nhân</a>
</li>
<li>
<a class="dropdown-item" asp-controller="DonHang" asp-action="Index">Đơn hàng của tôi</a>
</li>
                                @if (role == "Admin") { <li>
<a class="dropdown-item" asp-controller="Dashboard" asp-action="Index">Dashboard quản trị</a>
</li> }
                                <li>
<hr class="dropdown-divider"/>
</li>
<li>
<a class="dropdown-item" asp-controller="TaiKhoan" asp-action="Logout">Đăng xuất</a>
</li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="account-button" asp-controller="TaiKhoan" asp-action="Login">
<svg class="icon">
<use href="#i-user"/>
</svg>
<span>
<small>Chào mừng bạn</small>
<strong>Đăng nhập</strong>
</span>
</a>
                    }
                    <a class="cart-link" asp-controller="GioHang" asp-action="Index" aria-label="Giỏ hàng, @cartCount sản phẩm">
<svg class="icon">
<use href="#i-cart"/>
</svg>
<span class="cart-count">@cartCount</span>
<span class="cart-label">Giỏ hàng</span>
</a>
                </div>
            </div>
            <nav class="store-nav store-container" aria-label="Điều hướng cửa hàng">
                <a class="@(controller == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index" asp-route-view="store">Trang chủ</a>
                <a class="@(controller == "SanPham" ? "active" : "")" asp-controller="SanPham" asp-action="Index" asp-route-view="store">Tất cả sản phẩm</a>
                <a asp-controller="SanPham" asp-action="Index" asp-route-view="store" asp-route-sapXep="gia_asc">Mua sắm theo giá</a>
                @if (!string.IsNullOrEmpty(role)) { <a asp-controller="DonHang" asp-action="Index">Theo dõi đơn hàng</a> }
                <span class="store-nav-note">
<svg class="icon">
<use href="#i-shield"/>
</svg> Thông tin bảo hành theo sản phẩm</span>
            </nav>
        </header>
        <main id="main-content" class="store-container store-main" tabindex="-1">
<partial name="_Messages" />@RenderBody()</main>
        <footer class="store-footer">
            <div class="store-container footer-grid">
                <div>
<a class="brand brand-light" asp-controller="Home" asp-action="Index" asp-route-view="store">
<span class="brand-mark">u<span>.</span>
</span>
<span>UNETI<span class="brand-caption">ĐIỆN TỬ & CÔNG NGHỆ</span>
</span>
</a>
<p>Khám phá công nghệ phù hợp với bạn.<br/>Một trải nghiệm mua sắm rõ ràng, thuận tiện.</p>
</div>
                <div>
<h3>Khám phá</h3>
<a asp-controller="SanPham" asp-action="Index" asp-route-view="store">Tất cả sản phẩm</a>
<a asp-controller="GioHang" asp-action="Index">Giỏ hàng của bạn</a>
</div>
                <div>
<h3>Tài khoản</h3>
<a asp-controller="KhachHang" asp-action="HoSo" asp-route-view="store">Thông tin cá nhân</a>
<a asp-controller="DonHang" asp-action="Index">Theo dõi đơn hàng</a>
</div>
            </div>
            <div class="store-container footer-bottom">
<span>© @DateTime.Now.Year Điện tử UNETI · Nhóm 6</span>
<span>Quản lý cửa hàng điện tử & đặt hàng</span>
</div>
        </footer>
    }
    <script src="~/lib/jquery/dist/jquery.min.js">
</script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
</script>
    <script src="~/js/site.js" asp-append-version="true" data-product-placeholder="@Url.Content("~/images/product-placeholder.svg")">
</script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
