@model IEnumerable<QuanLyCuaHangDienTu_UNETI06_TI17A2HN.Models.KhachHang>

@{
    ViewData["Title"] = "Quản lý khách hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1 text-primary fw-bold">Quản lý khách hàng</h2>
        <p class="text-muted mb-0">Theo dõi thông tin khách hàng, số lượng đơn đặt hàng và tổng chi tiêu</p>
    </div>
    <a asp-action="Create" class="btn btn-success shadow-sm">
        + Thêm khách hàng mới
    </a>
</div>

<!-- Form Tìm kiếm tra cứu khách hàng -->
<div class="card mb-4 border-0 shadow-sm bg-light">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-center">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-white text-secondary">🔍</span>
                    <input type="text" name="tuKhoa" value="@ViewBag.CurrentTuKhoa" class="form-control" placeholder="Nhập tên khách hàng, số điện thoại, email hoặc địa chỉ..." />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 fw-semibold">Tìm kiếm</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách khách hàng -->
@if (!Model.Any())
{
    <div class="alert alert-warning text-center p-4 rounded shadow-sm" role="alert">
        Không tìm thấy thông tin khách hàng nào phù hợp với từ khóa tìm kiếm.
    </div>
}
else
{
    <div class="table-responsive shadow-sm rounded-3">
        <table class="table table-hover align-middle mb-0 bg-white">
            <thead class="table-dark">
                <tr>
                    <th class="text-center" style="width: 60px;">#</th>
                    <th>Họ và tên</th>
                    <th>Số điện thoại</th>
                    <th>Email</th>
                    <th>Địa chỉ</th>
                    <th class="text-center">Số đơn hàng</th>
                    <th class="text-end">Tổng chi tiêu</th>
                    <th class="text-center" style="width: 210px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @{ int stt = 1; }
                @foreach (var item in Model)
                {
                    int orderCount = item.DonHangs?.Count ?? 0;
                    decimal totalSpent = item.DonHangs?.Where(d => d.TrangThai != "DaHuy").Sum(d => d.TongTien) ?? 0;

                    <tr>
                        <td class="text-center fw-bold text-secondary">@(stt++)</td>
                        <td>
                            <strong class="text-dark">@item.HoTen</strong>
                            @if (item.TaiKhoan != null)
                            {
                                <span class="badge bg-info text-dark ms-1" title="Tài khoản hệ thống">@item.TaiKhoan.TenDangNhap</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@item.SoDienThoai</span>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(item.Email) ? "-" : item.Email)</td>
                        <td>@(string.IsNullOrWhiteSpace(item.DiaChi) ? "-" : item.DiaChi)</td>
                        <td class="text-center">
                            <span class="badge bg-secondary rounded-pill">@orderCount đơn</span>
                        </td>
                        <td class="text-end text-success fw-bold">
                            @totalSpent.ToString("N0") ₫
                        </td>
                        <td class="text-center text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.MaKhachHang" class="btn btn-sm btn-outline-info" title="Xem chi tiết & đơn hàng">Chi tiết</a>
                            <a asp-action="Edit" asp-route-id="@item.MaKhachHang" class="btn btn-sm btn-outline-primary" title="Chỉnh sửa">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.MaKhachHang" class="btn btn-sm btn-outline-danger" title="Xóa">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
