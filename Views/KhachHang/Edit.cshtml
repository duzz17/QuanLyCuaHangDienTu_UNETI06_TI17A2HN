@model QuanLyCuaHangDienTu_UNETI06_TI17A2HN.Models.KhachHang

@{
    ViewData["Title"] = "Sửa thông tin khách hàng - " + Model.HoTen;
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fw-bold">✏️ Cập nhật thông tin khách hàng</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="MaKhachHang" />
                    <input type="hidden" asp-for="NgayDangKy" />
                    <input type="hidden" asp-for="HinhAnh" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                    <!-- Hiển thị ảnh đại diện khách hàng (Chỉ xem) -->
                    <div class="d-flex align-items-center gap-3 p-3 bg-light rounded border mb-3">
                        @if (!string.IsNullOrEmpty(Model.HinhAnh))
                        {
                            <img src="@Model.HinhAnh" alt="Avatar" class="rounded-circle shadow-sm" style="width: 56px; height: 56px; object-fit: cover; border: 2px solid #2d6a4f;" />
                        }
                        else
                        {
                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 56px; height: 56px; font-size: 1.4rem; font-weight: 700; background-color: #2d6a4f;">
                                @(string.IsNullOrWhiteSpace(Model.HoTen) ? "K" : Model.HoTen.Trim()[..1].ToUpper())
                            </div>
                        }
                        <div>
                            <div class="fw-semibold text-dark">Ảnh đại diện khách hàng</div>
                            <div class="text-muted small">Khách hàng tự quản lý ảnh đại diện trong hồ sơ cá nhân (chỉ xem, quản trị viên không được xóa hoặc thay đổi).</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="HoTen" class="form-label fw-bold">Họ và tên khách hàng <span class="text-danger">*</span></label>
                        <input asp-for="HoTen" class="form-control" />
                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="SoDienThoai" class="form-label fw-bold">Số điện thoại <span class="text-danger">*</span></label>
                            <input asp-for="SoDienThoai" class="form-control" />
                            <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-bold">Email</label>
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="DiaChi" class="form-label fw-bold">Địa chỉ giao hàng / Thường trú</label>
                        <textarea asp-for="DiaChi" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="DiaChi" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary">← Trở lại danh sách</a>
                        <button type="submit" class="btn btn-primary px-4">Cập nhật thông tin</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
