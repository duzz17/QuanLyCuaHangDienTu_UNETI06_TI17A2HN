@model QuanLyCuaHangDienTu_UNETI06_TI17A2HN.Models.KhachHang

@{
    ViewData["Title"] = "Xóa khách hàng - " + Model.HoTen;
    bool hasOrders = ViewBag.HasOrders ?? false;
    int orderCount = ViewBag.OrderCount ?? 0;
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="mb-0 fw-bold">⚠️ Xác nhận xóa khách hàng</h4>
            </div>
            <div class="card-body p-4">
                @if (hasOrders)
                {
                    <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                        <div class="fs-4 me-3">🛑</div>
                        <div>
                            <strong>Không thể xóa khách hàng này!</strong><br />
                            Khách hàng <strong>@Model.HoTen</strong> hiện đang có <strong>@orderCount đơn hàng</strong> lưu trong hệ thống. Việc xóa khách hàng sẽ làm mất toàn vẹn dữ liệu đơn hàng.
                        </div>
                    </div>
                }
                else
                {
                    <p class="fs-5 text-dark mb-4">Bạn có chắc chắn muốn xóa khách hàng sau khỏi hệ thống?</p>
                }

                <div class="p-3 bg-light rounded border mb-4">
                    <table class="table table-borderless align-middle mb-0">
                        <tr>
                            <th style="width: 130px;" class="text-secondary">Mã KH:</th>
                            <td>#KH-@Model.MaKhachHang</td>
                        </tr>
                        <tr>
                            <th class="text-secondary">Họ và tên:</th>
                            <td class="fw-bold text-dark fs-5">@Model.HoTen</td>
                        </tr>
                        <tr>
                            <th class="text-secondary">Số điện thoại:</th>
                            <td>@Model.SoDienThoai</td>
                        </tr>
                        <tr>
                            <th class="text-secondary">Email:</th>
                            <td>@(string.IsNullOrWhiteSpace(Model.Email) ? "-" : Model.Email)</td>
                        </tr>
                        <tr>
                            <th class="text-secondary">Địa chỉ:</th>
                            <td>@(string.IsNullOrWhiteSpace(Model.DiaChi) ? "-" : Model.DiaChi)</td>
                        </tr>
                    </table>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="MaKhachHang" />
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary">← Hủy bỏ & Trở lại</a>
                        @if (!hasOrders)
                        {
                            <button type="submit" class="btn btn-danger px-4">🗑️ Xác nhận Xóa</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary px-4" disabled>Bị khóa do có đơn hàng</button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
