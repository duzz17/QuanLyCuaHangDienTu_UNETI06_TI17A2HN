@model QuanLyCuaHangDienTu_UNETI06_TI17A2HN.Models.KhachHang

@{
    ViewData["Title"] = "Thêm khách hàng mới";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-success text-white py-3">
                <h4 class="mb-0 fw-bold">➕ Thêm khách hàng mới</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="HoTen" class="form-label fw-bold">Họ và tên khách hàng <span class="text-danger">*</span></label>
                        <input asp-for="HoTen" class="form-control" placeholder="Nhập họ và tên đầy đủ..." />
                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="SoDienThoai" class="form-label fw-bold">Số điện thoại <span class="text-danger">*</span></label>
                            <input asp-for="SoDienThoai" class="form-control" placeholder="Ví dụ: 0987654321" />
                            <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-bold">Email</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="nguyenvana@gmail.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="DiaChi" class="form-label fw-bold">Địa chỉ giao hàng / Thường trú</label>
                        <textarea asp-for="DiaChi" class="form-control" rows="3" placeholder="Nhập địa chỉ cụ thể (Số nhà, Đường, Phường/Xã, Quận/Huyện, Tỉnh/TP)..."></textarea>
                        <span asp-validation-for="DiaChi" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary">← Trở lại danh sách</a>
                        <button type="submit" class="btn btn-success px-4">Lưu thông tin</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
