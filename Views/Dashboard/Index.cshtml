@model DashboardViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Tổng quan";
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var pending = Model.Statuses.FirstOrDefault(s => s.Status == "ChoXacNhan")?.Count ?? 0;
    var maxRevenue = Math.Max(Model.RevenuePoints.Max(p => p.Amount), 1);
}
<div class="page-heading">
<div>
<span class="eyebrow">KHÔNG GIAN QUẢN TRỊ</span>
<h1>Tổng quan cửa hàng<span class="heading-dot">.</span>
</h1>
<p>Xin chào @Context.Session.GetString("HoTen"), cùng xem hoạt động cửa hàng hôm nay.</p>
</div>
<a class="btn btn-primary" asp-controller="SanPham" asp-action="Create">
<svg class="icon">
<use href="#i-plus"/>
</svg> Thêm sản phẩm</a>
</div>
<div class="dashboard-period">
<span>
<svg class="icon">
<use href="#i-clock"/>
</svg> @DateTime.Today.AddDays(1 - Model.Days).ToString("dd/MM/yyyy") — @DateTime.Today.ToString("dd/MM/yyyy")</span>
<form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
<label for="dashboard-days">Khoảng thời gian</label>
<select id="dashboard-days" name="days" class="form-select form-select-sm" data-submit-on-change>
<option value="7" selected="@(Model.Days == 7)">7 ngày gần nhất</option>
<option value="30" selected="@(Model.Days == 30)">30 ngày gần nhất</option>
<option value="90" selected="@(Model.Days == 90)">90 ngày gần nhất</option>
</select>
<button type="submit" class="btn btn-sm btn-outline-secondary">Xem</button>
</form>
</div>
<div class="metrics-grid">
    <article class="metric-card metric-featured">
<div class="metric-label">Doanh thu trong kỳ<svg class="icon">
<use href="#i-wallet"/>
</svg>
</div>
<strong>@Model.Revenue.ToString("N0", vi)<small> ₫</small>
</strong>
<span>Từ các đơn đã giao, theo ngày đặt</span>
<div class="metric-decoration">
</div>
</article>
    <article class="metric-card">
<div class="metric-label">Đơn hàng trong kỳ<span class="metric-icon">
<svg class="icon">
<use href="#i-bag"/>
</svg>
</span>
</div>
<strong>@Model.OrderCount.ToString("N0", vi)</strong>
<span>
<b class="text-amber">@pending chờ xác nhận</b> trong kỳ đã chọn</span>
</article>
    <article class="metric-card">
<div class="metric-label">Sản phẩm đang bán<span class="metric-icon">
<svg class="icon">
<use href="#i-box"/>
</svg>
</span>
</div>
<strong>@Model.ProductCount.ToString("N0", vi)</strong>
<span>@Model.StockCount.ToString("N0", vi) sản phẩm trong kho</span>
</article>
    <article class="metric-card">
<div class="metric-label">Khách hàng<span class="metric-icon">
<svg class="icon">
<use href="#i-users"/>
</svg>
</span>
</div>
<strong>@Model.CustomerCount.ToString("N0", vi)</strong>
<span>Tổng hồ sơ khách hàng trong hệ thống</span>
</article>
</div>
<div class="dashboard-chart-grid">
    <section class="panel">
<div class="panel-heading">
<div>
<h2>Doanh thu theo ngày</h2>
<p>Đơn đã giao trong @Model.Days ngày gần nhất</p>
</div>
<span class="chart-legend">
<i>
</i> Doanh thu</span>
</div>
        @if (Model.Revenue == 0) { <div class="chart-zero-note">Chưa có doanh thu từ đơn đã giao trong khoảng thời gian này.</div> }
        <div class="revenue-chart" role="img" aria-label="Biểu đồ doanh thu theo ngày, tổng @Model.Revenue.ToString("N0", vi) đồng">
<div class="chart-grid-lines">
<span>@maxRevenue.ToString("N0", vi) ₫</span>
<span>@((maxRevenue / 2).ToString("N0", vi)) ₫</span>
<span>0 ₫</span>
</div>
<div class="chart-bars">
            @for (var i = 0; i < Model.RevenuePoints.Count; i++)
            {
                var point = Model.RevenuePoints[i];
                var height = (point.Amount / maxRevenue * 100).ToString("0.##", CultureInfo.InvariantCulture);
                var showLabel = Model.Days == 7 || i == 0 || i == Model.Days - 1 || i % Math.Max(1, Model.Days / 5) == 0;
                <div class="chart-column">
<div class="chart-bar-track">
<span class="chart-bar" style="height: @(height)%" tabindex="0" aria-label="@point.Date.ToString("dd/MM"): @point.Amount.ToString("N0", vi) đồng" title="@point.Date.ToString("dd/MM"): @point.Amount.ToString("N0", vi) ₫">
</span>
</div>
<span class="chart-date">@(showLabel ? point.Date.ToString("dd/MM") : "")</span>
</div>
            }
        </div>
</div>
        <details class="chart-data">
<summary>Xem số liệu doanh thu</summary>
<div class="table-responsive chart-data-table">
<table class="table">
<thead>
<tr>
<th>Ngày đặt</th>
<th class="text-end">Doanh thu đơn đã giao</th>
</tr>
</thead>
<tbody>@foreach (var point in Model.RevenuePoints) { <tr>
<td>@point.Date.ToString("dd/MM/yyyy")</td>
<td class="text-end">@point.Amount.ToString("N0", vi) ₫</td>
</tr> }</tbody>
</table>
</div>
</details>
    </section>
    <section class="panel">
<div class="panel-heading">
<div>
<h2>Trạng thái đơn hàng</h2>
<p>Trong khoảng thời gian đã chọn</p>
</div>
<svg class="icon text-muted">
<use href="#i-bag"/>
</svg>
</div>
<div class="status-total">
<strong>@Model.OrderCount</strong>
<span>tổng đơn hàng</span>
</div>
<div class="status-stacked-bar" aria-hidden="true">@foreach (var status in Model.Statuses) { <span class="@status.CssClass" style="width: @((Model.OrderCount == 0 ? 0 : (decimal)status.Count / Model.OrderCount * 100).ToString("0.##", CultureInfo.InvariantCulture))%">
</span> }</div>
<div class="status-list">@foreach (var status in Model.Statuses) { <a asp-controller="DonHang" asp-action="Index" asp-route-trangThai="@status.Status" asp-route-tuNgay="@DateTime.Today.AddDays(1 - Model.Days).ToString("yyyy-MM-dd")" asp-route-denNgay="@DateTime.Today.ToString("yyyy-MM-dd")">
<span class="status-dot @status.CssClass">
</span>
<span>@status.Label</span>
<strong>@status.Count</strong>
<svg class="icon">
<use href="#i-arrow"/>
</svg>
</a> }</div>
</section>
</div>
<div class="dashboard-content-grid">
    <section class="panel">
<div class="panel-heading">
<div>
<h2>Đơn hàng gần đây</h2>
<p>Các đơn mới nhất trong hệ thống</p>
</div>
<a class="text-link" asp-controller="DonHang" asp-action="Index">Xem tất cả <svg class="icon">
<use href="#i-arrow"/>
</svg>
</a>
</div>
<div class="table-responsive">
<table class="table align-middle mb-0">
<thead>
<tr>
<th>Mã đơn / Ngày đặt</th>
<th>Khách hàng</th>
<th class="text-end">Tổng tiền</th>
<th>Trạng thái</th>
<th>
<span class="visually-hidden">Chi tiết</span>
</th>
</tr>
</thead>
<tbody>@foreach (var order in Model.RecentOrders) { <tr>
<td>
<a class="table-id" asp-controller="DonHang" asp-action="Details" asp-route-id="@order.MaDonHang">#DH@(order.MaDonHang.ToString("D4"))</a>
<small class="cell-caption">@order.NgayDat.ToString("dd/MM/yyyy HH:mm")</small>
</td>
<td>
<strong>@(order.KhachHang?.HoTen ?? "Khách hàng")</strong>
<small class="cell-caption">@order.SoDienThoaiGiaoHang</small>
</td>
<td class="text-end text-nowrap fw-semibold">@order.TongTien.ToString("N0", vi) ₫</td>
<td>
<partial name="_OrderStatus" model="order.TrangThai" />
</td>
<td>
<a class="icon-button" asp-controller="DonHang" asp-action="Details" asp-route-id="@order.MaDonHang" aria-label="Xem đơn @order.MaDonHang">
<svg class="icon">
<use href="#i-arrow"/>
</svg>
</a>
</td>
</tr> }@if (Model.RecentOrders.Count == 0) { <tr>
<td colspan="5" class="empty-table">Chưa có đơn hàng. Các đơn mới sẽ xuất hiện tại đây.</td>
</tr> }</tbody>
</table>
</div>
</section>
    <section class="panel stock-panel">
<div class="panel-heading">
<div>
<h2>Cần chú ý tồn kho</h2>
<p>@Model.LowStockCount sản phẩm còn tối đa 5 đơn vị</p>
</div>
<span class="warning-icon">
<svg class="icon">
<use href="#i-alert"/>
</svg>
</span>
</div>
<div class="stock-list">@foreach (var product in Model.LowStockProducts) { <a asp-controller="SanPham" asp-action="Edit" asp-route-id="@product.MaSanPham">
<img src="@(string.IsNullOrWhiteSpace(product.HinhAnh) ? Url.Content("~/images/product-placeholder.svg") : product.HinhAnh)" alt="" data-product-name="@product.TenSanPham" data-product-image/>
<div>
<strong>@product.TenSanPham</strong>
<span>@product.ThuongHieu</span>
</div>
<span class="stock-number @(product.SoLuong == 0 ? "out" : "")">@product.SoLuong<small>còn lại</small>
</span>
</a> }@if (Model.LowStockProducts.Count == 0) { <div class="compact-empty">
<svg class="icon">
<use href="#i-check"/>
</svg>
<strong>Tồn kho ổn định</strong>
<p>Chưa có sản phẩm cần bổ sung.</p>
</div> }</div>
<a class="panel-footer-link" asp-controller="SanPham" asp-action="Index" asp-route-trangThai="true" asp-route-sapXep="ton_asc">Kiểm tra kho hàng <svg class="icon">
<use href="#i-arrow"/>
</svg>
</a>
</section>
</div>
<section class="panel best-seller-panel">
<div class="panel-heading">
<div>
<h2>Sản phẩm bán chạy</h2>
<p>Theo số lượng trong đơn đã giao của kỳ đã chọn</p>
</div>
<svg class="icon text-muted">
<use href="#i-chart"/>
</svg>
</div>
<div class="best-seller-grid">@for (var i = 0; i < Model.BestSellers.Count; i++) { var product = Model.BestSellers[i]; <a class="best-seller" asp-controller="SanPham" asp-action="Details" asp-route-id="@product.Id">
<span class="seller-rank">@((i + 1).ToString("D2"))</span>
<img src="@(string.IsNullOrWhiteSpace(product.Image) ? Url.Content("~/images/product-placeholder.svg") : product.Image)" alt="" data-product-name="@product.Name" data-product-image/>
<div>
<strong>@product.Name</strong>
<span>Đã bán @product.Quantity · @product.Revenue.ToString("N0", vi) ₫</span>
</div>
</a> }@if (Model.BestSellers.Count == 0) { <p class="best-seller-empty">Sản phẩm bán chạy sẽ xuất hiện khi có đơn hàng được giao thành công.</p> }</div>
</section>
