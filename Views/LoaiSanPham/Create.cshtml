@*
    Họ và tên: Nguyễn Xuân Đức
    Mã sinh viên: 23103100062
    Nội dung thực hiện: Giao diện thêm mới loại sản phẩm, Validation, chọn TrangThai (Module 1 - Tuần 2: M1-09, M1-10 | Tuần 3: Bổ sung trường TrangThai)
*@
@model QuanLyCuaHangDienTu_UNETI06_TI17A2HN.Models.LoaiSanPham
@{
    ViewData["Title"] = "Thêm loại sản phẩm";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white py-3">
                <h5 class="card-title mb-0 fw-bold">THÊM LOẠI SẢN PHẨM MỚI</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="TenLoai" class="form-label fw-semibold"></label>
                        <input asp-for="TenLoai" class="form-control" placeholder="Ví dụ: Điện thoại, Laptop, Bàn phím..." autofocus />
                        <span asp-validation-for="TenLoai" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MoTa" class="form-label fw-semibold"></label>
                        <textarea asp-for="MoTa" class="form-control" rows="4" placeholder="Nhập mô tả loại sản phẩm (nếu có)..."></textarea>
                        <span asp-validation-for="MoTa" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TrangThai" class="form-label fw-semibold"></label>
                        <select asp-for="TrangThai" class="form-select">
                            <option value="true">Đang hoạt động</option>
                            <option value="false">Ngừng hoạt động</option>
                        </select>
                        <span asp-validation-for="TrangThai" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 justify-content-end mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            Quay lại
                        </a>
                        <button type="submit" class="btn btn-success px-4 fw-semibold">
                            Lưu loại sản phẩm
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
