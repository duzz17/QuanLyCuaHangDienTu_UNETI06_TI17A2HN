@*
    Họ và tên: Nguyễn Xuân Đức
    Mã sinh viên: 23103100062
    Nội dung thực hiện: Giao diện sửa loại sản phẩm, Validation (Module 1 - Tuần 2: M1-09, M1-10)
*@
@model QuanLyCuaHangDienTu_UNETI06_TI17A2HN.Models.LoaiSanPham
@{
    ViewData["Title"] = "Sửa loại sản phẩm";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-dark py-3">
                <h5 class="card-title mb-0 fw-bold">CHỈNH SỬA LOẠI SẢN PHẨM #@Model.MaLoai</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="MaLoai" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="TenLoai" class="form-label fw-semibold"></label>
                        <input asp-for="TenLoai" class="form-control" autofocus />
                        <span asp-validation-for="TenLoai" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MoTa" class="form-label fw-semibold"></label>
                        <textarea asp-for="MoTa" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="MoTa" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 justify-content-end mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            Quay lại
                        </a>
                        <button type="submit" class="btn btn-warning px-4 fw-semibold">
                            Cập nhật thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
