@*
    Họ và tên: Nguyễn Xuân Đức
    Mã sinh viên: 23103100062
    Nội dung thực hiện: Giao diện danh sách loại sản phẩm (Module 1 - Tuần 2: M1-09)
*@
@model IEnumerable<QuanLyCuaHangDienTu_UNETI06_TI17A2HN.Models.LoaiSanPham>
@{
    ViewData["Title"] = "Quản lý loại sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-1">Quản lý loại sản phẩm</h2>
        <p class="text-muted mb-0 small">Danh mục các loại sản phẩm trong cửa hàng</p>
    </div>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> + Thêm loại sản phẩm
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 100px;">Mã loại</th>
                        <th style="width: 250px;">Tên loại sản phẩm</th>
                        <th>Mô tả</th>
                        <th style="width: 150px;" class="text-center">Số sản phẩm</th>
                        <th style="width: 240px;" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-secondary">#@item.MaLoai</td>
                                <td class="fw-semibold text-primary">@item.TenLoai</td>
                                <td class="text-muted">@(string.IsNullOrWhiteSpace(item.MoTa) ? "—" : item.MoTa)</td>
                                <td class="text-center">
                                    <span class="badge bg-info text-dark">
                                        @(item.SanPhams?.Count ?? 0) sản phẩm
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@item.MaLoai" class="btn btn-sm btn-outline-info me-1">
                                        Chi tiết
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.MaLoai" class="btn btn-sm btn-outline-warning me-1">
                                        Sửa
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.MaLoai" class="btn btn-sm btn-outline-danger">
                                        Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                <em>Chưa có loại sản phẩm nào trong cơ sở dữ liệu.</em>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
