@model QuanLyCuaHangDienTu_UNETI06_TI17A2HN.Models.DonHang

@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.MaDonHang;
    string currentVaiTro = Context.Session.GetString("VaiTro") ?? "";
    bool isAdmin = currentVaiTro == "Admin";
}

<div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
    <div>
        <h2 class="mb-1 text-primary fw-bold">Chi tiết đơn hàng #@Model.MaDonHang</h2>
        <p class="text-muted mb-0">Đặt ngày @Model.NgayDat.ToString("dd/MM/yyyy HH:mm:ss")</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary">
            🖨️ In hóa đơn
        </button>
        <a asp-action="Index" class="btn btn-outline-primary">
            ← Trở lại danh sách
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Thẻ Thông tin người nhận -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0 fw-bold">👤 Thông tin giao nhận</h5>
            </div>
            <div class="card-body">
                <table class="table table-borderless align-middle mb-0">
                    <tr>
                        <th style="width: 140px;" class="text-secondary">Người nhận:</th>
                        <td><strong class="text-dark fs-5">@(Model.KhachHang?.HoTen ?? "Khách đặt hàng")</strong></td>
                    </tr>
                    <tr>
                        <th class="text-secondary">Số điện thoại:</th>
                        <td><strong class="text-primary fs-6">@Model.SoDienThoaiGiaoHang</strong></td>
                    </tr>
                    <tr>
                        <th class="text-secondary">Email:</th>
                        <td>@(string.IsNullOrWhiteSpace(Model.KhachHang?.Email) ? "Không có" : Model.KhachHang.Email)</td>
                    </tr>
                    <tr>
                        <th class="text-secondary">Địa chỉ giao:</th>
                        <td><span class="fw-semibold text-dark">@Model.DiaChiGiaoHang</span></td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <!-- Thẻ Trạng thái đơn hàng & Thao tác Quản trị -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0 fw-bold">⚙️ Trạng thái & Xử lý đơn hàng</h5>
            </div>
            <div class="card-body d-flex flex-column justify-content-between">
                <div class="mb-3 text-center p-3 bg-light rounded border">
                    <div class="text-muted small mb-1">Trạng thái hiện tại:</div>
                    @switch (Model.TrangThai)
                    {
                        case "ChoXacNhan":
                            <span class="badge bg-warning text-dark fs-5 p-2">⏳ Chờ xác nhận</span>
                            break;
                        case "DangGiao":
                            <span class="badge bg-info text-dark fs-5 p-2">🚚 Đang giao hàng</span>
                            break;
                        case "DaGiao":
                            <span class="badge bg-success fs-5 p-2">✅ Giao hàng thành công</span>
                            break;
                        case "DaHuy":
                            <span class="badge bg-danger fs-5 p-2">❌ Đã hủy</span>
                            break;
                        default:
                            <span class="badge bg-secondary fs-5 p-2">@Model.TrangThai</span>
                            break;
                    }
                </div>

                @if (isAdmin)
                {
                    <div class="card p-3 bg-light border-0">
                        <label class="form-label fw-bold text-dark mb-2">Cập nhật trạng thái đơn (Admin):</label>
                        <form asp-action="CapNhatTrangThai" method="post" class="d-flex gap-2">
                            <input type="hidden" name="id" value="@Model.MaDonHang" />
                            <select name="trangThaiMoi" class="form-select">
                                <option value="ChoXacNhan" selected="@(Model.TrangThai == "ChoXacNhan" ? "selected" : null)">⏳ Chờ xác nhận</option>
                                <option value="DangGiao" selected="@(Model.TrangThai == "DangGiao" ? "selected" : null)">🚚 Đang giao hàng</option>
                                <option value="DaGiao" selected="@(Model.TrangThai == "DaGiao" ? "selected" : null)">✅ Giao hàng thành công</option>
                                <option value="DaHuy" selected="@(Model.TrangThai == "DaHuy" ? "selected" : null)">❌ Hủy đơn hàng</option>
                            </select>
                            <button type="submit" class="btn btn-primary text-nowrap fw-bold">Cập nhật</button>
                        </form>
                    </div>
                }
                else if (Model.TrangThai == "ChoXacNhan")
                {
                    <form asp-action="HuyDon" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này?');">
                        <input type="hidden" name="id" value="@Model.MaDonHang" />
                        <button type="submit" class="btn btn-outline-danger w-100 fw-bold py-2">
                            🚫 Hủy đơn hàng này
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<!-- Bảng Danh sách Chi tiết sản phẩm trong đơn hàng -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold text-primary">📦 Danh sách sản phẩm mua</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;" class="text-center">Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Loại sản phẩm</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-end">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ChiTietDonHangs)
                    {
                        decimal thanhTien = item.DonGia * item.SoLuong;
                        <tr>
                            <td class="text-center">
                                @if (!string.IsNullOrWhiteSpace(item.SanPham?.HinhAnh))
                                {
                                    <img src="@item.SanPham.HinhAnh" alt="@item.SanPham.TenSanPham" style="max-height: 50px; max-width: 60px; object-fit: cover;" class="rounded border" />
                                }
                                else
                                {
                                    <div class="bg-light rounded text-muted small p-2 border">No img</div>
                                }
                            </td>
                            <td>
                                <strong class="text-dark d-block">@(item.SanPham?.TenSanPham ?? "Sản phẩm")</strong>
                                <small class="text-muted">Bảo hành: @(item.SanPham?.ThoiGianBaoHanh ?? 0) tháng</small>
                            </td>
                            <td>
                                <span class="badge bg-info text-dark">@(item.SanPham?.LoaiSanPham?.TenLoai ?? "-")</span>
                            </td>
                            <td class="text-end fw-semibold">@item.DonGia.ToString("N0") ₫</td>
                            <td class="text-center fw-bold fs-6">x@item.SoLuong</td>
                            <td class="text-end text-danger fw-bold fs-6">@thanhTien.ToString("N0") ₫</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="5" class="text-end fw-bold fs-5">TỔNG CỘNG TIỀN ĐƠN HÀNG:</td>
                        <td class="text-end text-danger fw-bold fs-4">@Model.TongTien.ToString("N0") ₫</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
