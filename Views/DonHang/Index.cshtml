@model IEnumerable<QuanLyCuaHangDienTu_UNETI06_TI17A2HN.Models.DonHang>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
    string currentVaiTro = Context.Session.GetString("VaiTro") ?? "";
    bool isAdmin = currentVaiTro == "Admin";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1 text-primary fw-bold">@(isAdmin ? "Quản lý đơn hàng hệ thống" : "Lịch sử đơn hàng của tôi")</h2>
        <p class="text-muted mb-0">Theo dõi trạng thái và chi tiết các đơn đặt hàng</p>
    </div>
</div>

<!-- Bộ lọc tìm kiếm đơn hàng -->
<div class="card mb-4 border-0 shadow-sm bg-light">
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Từ khóa tìm kiếm</label>
                    <input type="text" name="tuKhoa" value="@ViewBag.CurrentTuKhoa" class="form-control" placeholder="Mã đơn hàng, tên KH, SĐT..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Trạng thái đơn hàng</label>
                    <select name="trangThai" class="form-select">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="ChoXacNhan" selected="@(ViewBag.CurrentTrangThai == "ChoXacNhan" ? "selected" : null)">Chờ xác nhận</option>
                        <option value="DangGiao" selected="@(ViewBag.CurrentTrangThai == "DangGiao" ? "selected" : null)">Đang giao hàng</option>
                        <option value="DaGiao" selected="@(ViewBag.CurrentTrangThai == "DaGiao" ? "selected" : null)">Đã hoàn thành (Giao thành công)</option>
                        <option value="DaHuy" selected="@(ViewBag.CurrentTrangThai == "DaHuy" ? "selected" : null)">Đã hủy</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Từ ngày</label>
                    <input type="date" name="tuNgay" value="@ViewBag.CurrentTuNgay" class="form-control" />
                </div>
                <div class="col-md-2 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold">Lọc</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách đơn hàng -->
@if (!Model.Any())
{
    <div class="alert alert-warning text-center p-4 rounded shadow-sm" role="alert">
        Không tìm thấy đơn hàng nào phù hợp với bộ lọc.
    </div>
}
else
{
    <div class="table-responsive shadow-sm rounded-3">
        <table class="table table-hover align-middle mb-0 bg-white">
            <thead class="table-dark">
                <tr>
                    <th style="width: 100px;">Mã đơn</th>
                    <th>Ngày đặt</th>
                    <th>Khách hàng / Người nhận</th>
                    <th>SĐT Giao hàng</th>
                    <th class="text-center">Số mục</th>
                    <th class="text-end">Tổng tiền</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center" style="width: 150px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    int itemCount = item.ChiTietDonHangs?.Sum(c => c.SoLuong) ?? 0;
                    <tr>
                        <td>
                            <strong class="text-primary">#@item.MaDonHang</strong>
                        </td>
                        <td>@item.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <strong class="text-dark">@(item.KhachHang?.HoTen ?? "Khách lẻ")</strong>
                            <div class="small text-muted text-truncate" style="max-width: 200px;">@item.DiaChiGiaoHang</div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@item.SoDienThoaiGiaoHang</span>
                        </td>
                        <td class="text-center">
                            <span class="badge bg-secondary">@(item.ChiTietDonHangs?.Count ?? 0) sản phẩm</span>
                        </td>
                        <td class="text-end text-danger fw-bold fs-6">
                            @item.TongTien.ToString("N0") ₫
                        </td>
                        <td class="text-center">
                            @switch (item.TrangThai)
                            {
                                case "ChoXacNhan":
                                    <span class="badge bg-warning text-dark p-2">⏳ Chờ xác nhận</span>
                                    break;
                                case "DangGiao":
                                    <span class="badge bg-info text-dark p-2">🚚 Đang giao hàng</span>
                                    break;
                                case "DaGiao":
                                    <span class="badge bg-success p-2">✅ Đã hoàn thành</span>
                                    break;
                                case "DaHuy":
                                    <span class="badge bg-danger p-2">❌ Đã hủy</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary p-2">@item.TrangThai</span>
                                    break;
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@item.MaDonHang" class="btn btn-sm btn-outline-info" title="Xem chi tiết đơn hàng">
                                👁️ Chi tiết
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
