@*
    Họ và tên: Nguyễn Xuân Đức
    Mã sinh viên: 23103100062
    Nội dung thực hiện: Giao diện xác nhận đặt hàng - nhập địa chỉ giao hàng, tổng tiền, kiểm tra phân quyền (Module 1 - Tuần 3)
*@
@model List<CartItemViewModel>
@using System.Globalization
@{
    ViewData["Title"] = "Xác nhận đặt hàng";
    ViewData["Storefront"] = true;
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var total = Model.Sum(item => item.Gia * item.SoLuong);
    string diaChiMacDinh = ViewBag.DiaChiMacDinh ?? string.Empty;
    string sdtMacDinh = ViewBag.SdtMacDinh ?? string.Empty;
}

<nav class="simple-breadcrumb" aria-label="Đường dẫn">
    <a asp-controller="Home" asp-action="Index" asp-route-view="store">Trang chủ</a>
    <span>/</span>
    <a asp-controller="GioHang" asp-action="Index">Giỏ hàng</a>
    <span>/</span>
    <span>Xác nhận đặt hàng</span>
</nav>

<div class="page-heading">
    <div>
        <span class="eyebrow">BƯỚC CUỐI CÙNG</span>
        <h1>Xác nhận đặt hàng<span class="heading-dot">.</span></h1>
        <p>Kiểm tra lại đơn hàng và nhập địa chỉ giao hàng.</p>
    </div>
</div>

<div class="row g-4">
    @* Cột trái: danh sách sản phẩm *@
    <div class="col-lg-7">
        <div class="panel">
            <h5 class="fw-bold mb-3">Sản phẩm trong đơn hàng</h5>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Sản phẩm</th>
                            <th class="text-center">SL</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@item.TenSanPham</div>
                                    <div class="text-muted small">@item.Gia.ToString("N0", vi) ₫ / sản phẩm</div>
                                </td>
                                <td class="text-center">@item.SoLuong</td>
                                <td class="text-end fw-semibold text-nowrap">@((item.Gia * item.SoLuong).ToString("N0", vi)) ₫</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="2" class="text-end">Tổng cộng:</th>
                            <th class="text-end text-primary fs-5">@total.ToString("N0", vi) ₫</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    @* Cột phải: form nhập địa chỉ *@
    <div class="col-lg-5">
        <div class="panel">
            <h5 class="fw-bold mb-3">Thông tin giao hàng</h5>
            <form asp-controller="GioHang" asp-action="DatHang" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="diaChiGiaoHang" class="form-label fw-semibold">
                        Địa chỉ giao hàng <span class="text-danger">*</span>
                    </label>
                    <textarea id="diaChiGiaoHang" name="diaChiGiaoHang" class="form-control"
                              rows="3"
                              placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố"
                              required maxlength="250">@diaChiMacDinh</textarea>
                    <div class="form-text">Địa chỉ sẽ được lưu cho đơn hàng này.</div>
                </div>

                <div class="mb-4">
                    <label for="soDienThoaiGiaoHang" class="form-label fw-semibold">
                        Số điện thoại nhận hàng <span class="text-danger">*</span>
                    </label>
                    <input type="tel" id="soDienThoaiGiaoHang" name="soDienThoaiGiaoHang"
                           class="form-control" placeholder="0xxxxxxxxx"
                           value="@sdtMacDinh" required maxlength="20" />
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <svg class="icon"><use href="#i-bag" /></svg>
                        Đặt hàng · @total.ToString("N0", vi) ₫
                    </button>
                    <a asp-controller="GioHang" asp-action="Index" class="btn btn-outline-secondary">
                        Quay lại giỏ hàng
                    </a>
                </div>
            </form>
        </div>

        <div class="panel mt-3">
            <div class="d-flex gap-2 align-items-start">
                <svg class="icon text-success mt-1"><use href="#i-shield" /></svg>
                <div>
                    <strong>Đơn hàng an toàn</strong>
                    <p class="text-muted small mb-0">
                        Đơn hàng sẽ ở trạng thái "Chờ xác nhận" cho đến khi Admin xác nhận và giao hàng.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
