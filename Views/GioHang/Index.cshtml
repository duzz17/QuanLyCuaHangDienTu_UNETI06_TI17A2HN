@model QuanLyCuaHangDienTu_UNETI06_TI17A2HN.ViewModels.GioHangViewModel

@{
    ViewData["Title"] = "Giỏ hàng của bạn";
}

<div class="mb-4">
    <h2 class="text-primary fw-bold mb-1">🛒 Giỏ hàng mua sắm</h2>
    <p class="text-muted mb-0">Quản lý danh sách các thiết bị điện tử bạn đã chọn mua</p>
</div>

@if (!Model.Items.Any())
{
    <div class="card border-0 shadow-sm text-center py-5 px-3 mb-4">
        <div class="card-body">
            <div class="display-1 text-muted mb-3">🛒</div>
            <h4 class="fw-bold text-secondary mb-2">Giỏ hàng của bạn đang trống</h4>
            <p class="text-muted mb-4">Hãy lướt qua danh sách các thiết bị điện tử chất lượng cao và chọn cho mình sản phẩm ưng ý nhất!</p>
            <a asp-controller="SanPham" asp-action="Index" class="btn btn-primary btn-lg px-4 shadow-sm">
                🛍️ Khám phá sản phẩm ngay
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <!-- Danh sách sản phẩm trong giỏ -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-dark">Danh sách sản phẩm (<span id="cartTotalItems">@Model.TongSoLuong</span>)</h5>
                    <form asp-action="XoaGioHang" method="post" onsubmit="return confirm('Bạn có chắc muốn làm trống giỏ hàng?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">🗑️ Làm trống giỏ hàng</button>
                    </form>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 80px;">Hình ảnh</th>
                                <th>Sản phẩm</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-center" style="width: 160px;">Số lượng</th>
                                <th class="text-end">Thành tiền</th>
                                <th class="text-center" style="width: 60px;">Xóa</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr id="row-sp-@item.MaSanPham">
                                    <td class="text-center">
                                        @if (!string.IsNullOrWhiteSpace(item.HinhAnh))
                                        {
                                            <img src="@item.HinhAnh" alt="@item.TenSanPham" style="max-height: 50px; max-width: 60px; object-fit: cover;" class="rounded border" />
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded text-muted small p-2 text-center border">No img</div>
                                        }
                                    </td>
                                    <td>
                                        <strong class="text-dark d-block">@item.TenSanPham</strong>
                                        <small class="text-muted">Mã SP: #@item.MaSanPham</small>
                                    </td>
                                    <td class="text-end fw-semibold">@item.Gia.ToString("N0") ₫</td>
                                    <td>
                                        <form asp-action="CapNhatGioHang" method="post" class="d-flex align-items-center gap-1 justify-content-center ajax-cart-form" data-product-id="@item.MaSanPham">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="maSanPham" value="@item.MaSanPham" />
                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-qty-minus" style="width: 28px;">-</button>
                                            <input type="number" name="soLuong" value="@item.SoLuong" min="1" max="99" class="form-control form-control-sm text-center input-cart-qty" style="width: 50px;" />
                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-qty-plus" style="width: 28px;">+</button>
                                        </form>
                                    </td>
                                    <td class="text-end text-danger fw-bold fs-6 item-line-total" id="total-sp-@item.MaSanPham">
                                        @item.ThanhTien.ToString("N0") ₫
                                    </td>
                                    <td class="text-center">
                                        <form asp-action="XoaKhoiGio" method="post">
                                            <input type="hidden" name="maSanPham" value="@item.MaSanPham" />
                                            <button type="submit" class="btn btn-sm btn-link text-danger p-0 border-0" title="Xóa khỏi giỏ hàng">
                                                ❌
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-light p-3 d-flex justify-content-between align-items-center">
                    <a asp-controller="SanPham" asp-action="Index" class="text-decoration-none text-secondary">
                        ← Tiếp tục tìm xem sản phẩm
                    </a>
                </div>
            </div>
        </div>

        <!-- Cột Tổng quan giỏ hàng & Thanh toán & Voucher -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 fw-bold">Tóm tắt đơn hàng</h5>
                </div>
                <div class="card-body">
                    <!-- Khung Nhập Mã Giảm Giá (Chức năng nâng cao) -->
                    <div class="mb-3 p-3 bg-light rounded border">
                        <label class="form-label fw-bold small text-primary mb-2">🎟️ Mã giảm giá / Voucher</label>
                        <form asp-action="ApDungMaGiamGia" method="post" class="input-group input-group-sm mb-1">
                            <input type="text" name="maGiamGia" value="@Model.MaGiamGia" class="form-control text-uppercase font-monospace" placeholder="Mã voucher..." required />
                            <button class="btn btn-primary" type="submit">Áp dụng</button>
                        </form>
                        @if (!string.IsNullOrEmpty(Model.MaGiamGia) && Model.SoTienGiam > 0)
                        {
                            <div class="d-flex justify-content-between align-items-center mt-2 small text-success bg-white p-2 rounded border">
                                <span><i class="bi bi-check-circle-fill"></i> Đã dùng: <strong>@Model.MaGiamGia</strong></span>
                                <form asp-action="XoaMaGiamGia" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-link text-danger p-0 text-decoration-none" title="Bỏ voucher">✕ Bỏ mã</button>
                                </form>
                            </div>
                        }
                        <div class="text-muted mt-2" style="font-size: 11px;">
                            <div>💡 Gợi ý mã có sẵn:</div>
                            <span class="badge bg-secondary">UNETI10</span> Giảm 10% (tối đa 1tr)<br/>
                            <span class="badge bg-secondary">GIAM50K</span> Giảm 50.000 ₫<br/>
                            <span class="badge bg-secondary">DIENTU2026</span> Giảm 5%
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mb-2 text-secondary">
                        <span>Tạm tính hàng hóa:</span>
                        <strong class="text-dark" id="cartSubTotal">@Model.TongTien.ToString("N0") ₫</strong>
                    </div>
                    @if (Model.SoTienGiam > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 text-success" id="cartDiscountRow">
                            <span>Giảm giá voucher:</span>
                            <strong id="cartDiscount">-@Model.SoTienGiam.ToString("N0") ₫</strong>
                        </div>
                    }
                    <div class="d-flex justify-content-between mb-3 text-secondary">
                        <span>Phí vận chuyển:</span>
                        <span class="badge bg-success">Miễn phí</span>
                    </div>

                    <hr class="my-3" />

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fs-5 fw-bold text-dark">TỔNG CỘNG:</span>
                        <span class="fs-4 fw-bold text-danger" id="cartFinalTotal">@Model.TongTienSauGiam.ToString("N0") ₫</span>
                    </div>

                    <a asp-controller="DonHang" asp-action="DatHang" class="btn btn-success btn-lg w-100 fw-bold py-3 shadow">
                        🚀 Tiến hành Đặt hàng
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Xử lý AJAX cập nhật số lượng giỏ hàng tức thời không cần reload trang
            function updateCartAjax(form, newQty) {
                const formData = new FormData(form);
                formData.set('soLuong', newQty);

                fetch(form.action, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: formData
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        const pid = form.getAttribute('data-product-id');
                        const qtyInput = form.querySelector('.input-cart-qty');
                        if (qtyInput) qtyInput.value = data.itemQuantity;

                        const lineTotalEl = document.getElementById('total-sp-' + pid);
                        if (lineTotalEl) {
                            lineTotalEl.innerText = data.itemTotal.toLocaleString('vi-VN') + ' ₫';
                        }

                        const subTotalEl = document.getElementById('cartSubTotal');
                        if (subTotalEl) subTotalEl.innerText = data.subTotal.toLocaleString('vi-VN') + ' ₫';

                        const finalTotalEl = document.getElementById('cartFinalTotal');
                        if (finalTotalEl) finalTotalEl.innerText = data.finalTotal.toLocaleString('vi-VN') + ' ₫';

                        const discountEl = document.getElementById('cartDiscount');
                        if (discountEl) discountEl.innerText = '-' + data.discount.toLocaleString('vi-VN') + ' ₫';

                        const cartItemsEl = document.getElementById('cartTotalItems');
                        if (cartItemsEl) cartItemsEl.innerText = data.cartCount;

                        // Cập nhật badge trên navbar nếu có
                        const navCartBadge = document.querySelector('.cart-count, #cartCountBadge');
                        if (navCartBadge) navCartBadge.innerText = data.cartCount;
                    }
                })
                .catch(err => {
                    console.error('Lỗi cập nhật giỏ hàng:', err);
                    form.submit(); // Fallback form thông thường
                });
            }

            document.querySelectorAll('.btn-qty-minus').forEach(btn => {
                btn.addEventListener('click', function () {
                    const form = this.closest('.ajax-cart-form');
                    const input = form.querySelector('.input-cart-qty');
                    let val = parseInt(input.value) || 1;
                    if (val > 1) {
                        updateCartAjax(form, val - 1);
                    }
                });
            });

            document.querySelectorAll('.btn-qty-plus').forEach(btn => {
                btn.addEventListener('click', function () {
                    const form = this.closest('.ajax-cart-form');
                    const input = form.querySelector('.input-cart-qty');
                    let val = parseInt(input.value) || 1;
                    if (val < 99) {
                        updateCartAjax(form, val + 1);
                    }
                });
            });

            document.querySelectorAll('.input-cart-qty').forEach(input => {
                input.addEventListener('change', function () {
                    const form = this.closest('.ajax-cart-form');
                    let val = parseInt(this.value) || 1;
                    if (val < 1) val = 1;
                    if (val > 99) val = 99;
                    updateCartAjax(form, val);
                });
            });
        });
    </script>
}
