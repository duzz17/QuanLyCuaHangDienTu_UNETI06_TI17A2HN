@model SanPham
@using System.Globalization
@{
    var management = Context.Session.GetString("VaiTro") == "Admin" && Context.Request.Query["view"] != "store";
    ViewData["Title"] = Model.TenSanPham;
    ViewData["Storefront"] = !management;
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var available = Model.TrangThai && Model.SoLuong > 0;
}
<nav class="simple-breadcrumb" aria-label="Đường dẫn">
<a asp-controller="Home" asp-action="Index" asp-route-view="@(management ? "admin" : "store")">Trang chủ</a>
<span>/</span>
<a asp-action="Index" asp-route-view="@(management ? "admin" : "store")">Sản phẩm</a>
<span>/</span>
<span>@Model.LoaiSanPham?.TenLoai</span>
</nav>
<div class="product-detail-layout">
    <div class="detail-gallery">
<span class="detail-brand">@Model.ThuongHieu</span>
<img src="@(string.IsNullOrWhiteSpace(Model.HinhAnh) ? Url.Content("~/images/product-placeholder.svg") : Model.HinhAnh)" alt="@Model.TenSanPham" data-product-image/>
<div class="gallery-caption">Hình ảnh sản phẩm · #SP@(Model.MaSanPham.ToString("D4"))</div>
</div>
    <section class="detail-info">
<span class="eyebrow">@(Model.LoaiSanPham?.TenLoai ?? "THIẾT BỊ ĐIỆN TỬ")</span>
<h1>@Model.TenSanPham</h1>
<div class="detail-stock">
<span class="status-badge @(available ? "completed" : "neutral")">
<span>
</span>@(!Model.TrangThai ? "Ngừng kinh doanh" : Model.SoLuong <= 0 ? "Tạm hết hàng" : "Còn hàng")</span>@if (available) { <span class="text-muted">Còn @Model.SoLuong sản phẩm</span> }</div>
<div class="detail-price">
<small>Giá bán</small>
<strong>@Model.Gia.ToString("N0", vi) <span>₫</span>
</strong>
</div>
        <p class="detail-description">@(string.IsNullOrWhiteSpace(Model.MoTa) ? "Thông tin chi tiết đang được cập nhật." : Model.MoTa)</p>
        <dl class="product-specs">
<div>
<dt>Thương hiệu</dt>
<dd>@Model.ThuongHieu</dd>
</div>
<div>
<dt>Danh mục</dt>
<dd>@Model.LoaiSanPham?.TenLoai</dd>
</div>
<div>
<dt>Bảo hành</dt>
<dd>@Model.ThoiGianBaoHanh tháng</dd>
</div>
</dl>
        @if (available)
        {
            <form asp-controller="GioHang" asp-action="ThemVaoGio" method="post" class="purchase-form">
<input type="hidden" name="maSanPham" value="@Model.MaSanPham"/>
<label for="purchase-quantity">Số lượng</label>
<div class="purchase-actions">
<div class="quantity-stepper">
<button type="button" data-quantity-step="-1" aria-label="Giảm số lượng">−</button>
<input id="purchase-quantity" type="number" name="soLuong" value="1" min="1" max="@Model.SoLuong" aria-label="Số lượng sản phẩm"/>
<button type="button" data-quantity-step="1" aria-label="Tăng số lượng">+</button>
</div>
<button type="submit" class="btn btn-primary">
<svg class="icon">
<use href="#i-cart"/>
</svg> Thêm vào giỏ hàng</button>
</div>
</form>
        }
        else { <div class="availability-note">
<svg class="icon">
<use href="#i-alert"/>
</svg> Sản phẩm hiện chưa thể đặt mua. Hãy khám phá các sản phẩm khác trong cửa hàng.</div> }
        <div class="detail-service">
<svg class="icon">
<use href="#i-shield"/>
</svg>
<span>Thông tin giá và bảo hành được hiển thị rõ ràng trước khi đặt hàng.</span>
</div>
        @if (management) { <div class="detail-admin-actions">
<a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.MaSanPham">
<svg class="icon">
<use href="#i-edit"/>
</svg> Chỉnh sửa sản phẩm</a>
<a class="btn btn-outline-secondary" asp-action="Index">Về danh sách</a>
</div> }
    </section>
</div>
