@model SanPham

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Chi tiết sản phẩm</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.MaSanPham" class="btn btn-primary">Chỉnh sửa</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Mã sản phẩm</dt>
            <dd class="col-sm-9">@Model.MaSanPham</dd>

            <dt class="col-sm-3">Tên sản phẩm</dt>
            <dd class="col-sm-9">@Model.TenSanPham</dd>

            <dt class="col-sm-3">Loại sản phẩm</dt>
            <dd class="col-sm-9">@Model.LoaiSanPham?.TenLoai</dd>

            <dt class="col-sm-3">Mô tả</dt>
            <dd class="col-sm-9">@Model.MoTa</dd>

            <dt class="col-sm-3">Giá</dt>
            <dd class="col-sm-9">@Model.Gia.ToString("N0") ₫</dd>

            <dt class="col-sm-3">Số lượng</dt>
            <dd class="col-sm-9">@Model.SoLuong</dd>

            <dt class="col-sm-3">Hình ảnh</dt>
            <dd class="col-sm-9">
                @if (string.IsNullOrWhiteSpace(Model.HinhAnh))
                {
                    <span>Chưa có hình ảnh</span>
                }
                else
                {
                    <img src="@Model.HinhAnh" alt="@Model.TenSanPham" class="img-fluid rounded" style="max-height: 280px;" />
                }
            </dd>

            <dt class="col-sm-3">Ngày nhập</dt>
            <dd class="col-sm-9">@Model.NgayNhap.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">Trạng thái</dt>
            <dd class="col-sm-9">
                @if (Model.TrangThai)
                {
                    <span class="badge bg-success">Đang kinh doanh</span>
                }
                else
                {
                    <span class="badge bg-secondary">Ngừng kinh doanh</span>
                }
            </dd>
        </dl>
    </div>
</div>
