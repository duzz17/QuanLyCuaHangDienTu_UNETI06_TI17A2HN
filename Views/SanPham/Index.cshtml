@model IEnumerable<SanPham>
@using System.Globalization
@{
    var isAdmin = Context.Session.GetString("VaiTro") == "Admin" && Context.Request.Query["view"] != "store";
    ViewData["Title"] = isAdmin ? "Quản lý sản phẩm" : "Tất cả sản phẩm";
    ViewData["Storefront"] = !isAdmin;
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    var routes = new Dictionary<string, string>
    {
        ["view"] = isAdmin ? "admin" : "store",
        ["tuKhoa"] = (string?)ViewBag.CurrentTuKhoa ?? "",
        ["maLoai"] = Convert.ToString(ViewBag.CurrentMaLoai, CultureInfo.InvariantCulture) ?? "",
        ["thuongHieu"] = (string?)ViewBag.CurrentThuongHieu ?? "",
        ["trangThai"] = Convert.ToString(ViewBag.CurrentTrangThai, CultureInfo.InvariantCulture) ?? "",
        ["giaTu"] = Convert.ToString(ViewBag.CurrentGiaTu, CultureInfo.InvariantCulture) ?? "",
        ["giaDen"] = Convert.ToString(ViewBag.CurrentGiaDen, CultureInfo.InvariantCulture) ?? "",
        ["sapXep"] = (string?)ViewBag.CurrentSapXep ?? "",
        ["pageSize"] = Convert.ToString(ViewBag.PageSize, CultureInfo.InvariantCulture) ?? "6"
    };
}
@if (!isAdmin) { <nav class="simple-breadcrumb" aria-label="Đường dẫn">
<a asp-controller="Home" asp-action="Index" asp-route-view="store">Trang chủ</a>
<span>/</span>
<span>Sản phẩm</span>
</nav> }
<div class="page-heading">
<div>
<span class="eyebrow">@(isAdmin ? "QUẢN LÝ DANH MỤC HÀNG HÓA" : "KHÁM PHÁ & LỰA CHỌN")</span>
<h1>@(isAdmin ? "Sản phẩm" : "Tìm thiết bị dành cho bạn")<span class="heading-dot">.</span>
</h1>
<p>@(isAdmin ? "Quản lý thông tin, giá bán và tồn kho trong cùng một nơi." : "Lọc theo danh mục, thương hiệu và ngân sách để chọn sản phẩm phù hợp.")</p>
</div>@if (isAdmin) { <a asp-action="Create" class="btn btn-primary">
<svg class="icon">
<use href="#i-plus"/>
</svg> Thêm sản phẩm</a> }</div>
<div class="@(isAdmin ? "management-catalog" : "catalog-layout")">
    <aside class="@(isAdmin ? "panel management-filters" : "panel catalog-filters")">
        <div class="filter-heading">
<h2>
<svg class="icon">
<use href="#i-filter"/>
</svg> Bộ lọc sản phẩm</h2>
<button type="button" class="icon-button filter-toggle" data-bs-toggle="collapse" data-bs-target="#product-filters" aria-expanded="false" aria-controls="product-filters" aria-label="Mở bộ lọc">
<svg class="icon">
<use href="#i-plus"/>
</svg>
</button>
</div>
        <div class="collapse filter-content" id="product-filters">
<partial name="_ProductFilters" model="isAdmin" />
</div>
    </aside>
    <section class="catalog-results" aria-label="Danh sách sản phẩm">
        <div class="results-toolbar">
<span>
<strong>@ViewBag.TotalItems</strong> sản phẩm <span class="text-muted">· Hiển thị @ViewBag.FromItem–@ViewBag.ToItem</span>
</span>@if (isAdmin) { <span class="table-view-label">
<svg class="icon">
<use href="#i-grid"/>
</svg> Danh sách quản lý</span> } else { <span class="text-muted small">Giá niêm yết bằng VNĐ</span> }</div>
        @if (!Model.Any())
        {
            <div class="empty-state panel">
<svg class="icon">
<use href="#i-search"/>
</svg>
<h2>Chưa tìm thấy sản phẩm phù hợp</h2>
<p>Thử từ khóa khác hoặc mở rộng danh mục và khoảng giá.</p>
<a class="btn btn-primary" asp-action="Index" asp-route-view="@(isAdmin ? "admin" : "store")">Xóa bộ lọc</a>
</div>
        }
        else if (isAdmin)
        {
            <div class="panel table-responsive">
<table class="table product-management-table align-middle mb-0">
<thead>
<tr>
<th>Sản phẩm</th>
<th>Danh mục</th>
<th class="text-end">Giá bán</th>
<th class="text-center">Tồn kho</th>
<th>Trạng thái</th>
<th class="text-end">Thao tác</th>
</tr>
</thead>
<tbody>
                @foreach (var product in Model)
                {
                    <tr>
<td>
<div class="table-product">
<img src="@(string.IsNullOrWhiteSpace(product.HinhAnh) ? Url.Content("~/images/product-placeholder.svg") : product.HinhAnh)" alt="" data-product-name="@product.TenSanPham" data-product-image/>
<div>
<a asp-action="Details" asp-route-id="@product.MaSanPham">@product.TenSanPham</a>
<small>#SP@(product.MaSanPham.ToString("D4")) · @product.ThuongHieu · BH @product.ThoiGianBaoHanh tháng</small>
</div>
</div>
</td>
<td>@product.LoaiSanPham?.TenLoai</td>
<td class="text-end text-nowrap fw-semibold">@product.Gia.ToString("N0", vi) ₫</td>
<td class="text-center">
<span class="stock-pill @(product.SoLuong <= 5 ? "low" : "")">@product.SoLuong</span>
</td>
<td>
<form asp-action="DoiTrangThai" method="post">
<input type="hidden" name="id" value="@product.MaSanPham"/>
<button type="submit" class="status-badge @(product.TrangThai ? "completed" : "neutral")" title="Đổi trạng thái kinh doanh">
<span>
</span>@(product.TrangThai ? "Đang bán" : "Ngừng bán")</button>
</form>
</td>
<td>
<div class="table-actions">
<a class="icon-button" asp-action="Details" asp-route-id="@product.MaSanPham" aria-label="Xem @product.TenSanPham">
<svg class="icon">
<use href="#i-eye"/>
</svg>
</a>
<a class="icon-button" asp-action="Edit" asp-route-id="@product.MaSanPham" aria-label="Sửa @product.TenSanPham">
<svg class="icon">
<use href="#i-edit"/>
</svg>
</a>
<form asp-action="Delete" method="post" data-confirm="Xóa sản phẩm này? Sản phẩm đã có trong đơn hàng sẽ được giữ lại.">
<input type="hidden" name="id" value="@product.MaSanPham"/>
<button class="icon-button text-danger" type="submit" aria-label="Xóa @product.TenSanPham">
<svg class="icon">
<use href="#i-trash"/>
</svg>
</button>
</form>
</div>
</td>
</tr>
                }
            </tbody>
</table>
</div>
        }
        else
        {
            <div class="product-grid catalog-product-grid">@foreach (var product in Model) { <partial name="_ProductCard" model="product" /> }</div>
        }
        @if (totalPages > 1)
        {
            <nav class="catalog-pagination" aria-label="Phân trang sản phẩm">
<span>Trang @currentPage / @totalPages</span>
<ul class="pagination mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">@if (currentPage == 1) { <button class="page-link" disabled aria-label="Trang trước">‹</button> } else { <a class="page-link" asp-action="Index" asp-all-route-data="routes" asp-route-page="@(currentPage - 1)" aria-label="Trang trước">‹</a> }</li>
                @if (currentPage > 3) { <li class="page-item">
<a class="page-link" asp-action="Index" asp-all-route-data="routes" asp-route-page="1">1</a>
</li>@if (currentPage > 4) { <li class="page-item disabled">
<span class="page-link">…</span>
</li> } }
                @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++) { <li class="page-item @(p == currentPage ? "active" : "")">
<a class="page-link" asp-action="Index" asp-all-route-data="routes" asp-route-page="@p" aria-current="@(p == currentPage ? "page" : null)">@p</a>
</li> }
                @if (currentPage < totalPages - 2) { @if (currentPage < totalPages - 3) { <li class="page-item disabled">
<span class="page-link">…</span>
</li> }<li class="page-item">
<a class="page-link" asp-action="Index" asp-all-route-data="routes" asp-route-page="@totalPages">@totalPages</a>
</li> }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">@if (currentPage == totalPages) { <button class="page-link" disabled aria-label="Trang sau">›</button> } else { <a class="page-link" asp-action="Index" asp-all-route-data="routes" asp-route-page="@(currentPage + 1)" aria-label="Trang sau">›</a> }</li>
            </ul>
</nav>
        }
    </section>
</div>
