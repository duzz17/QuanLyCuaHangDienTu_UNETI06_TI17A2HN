@model IEnumerable<SanPham>

@{
    ViewData["Title"] = "Sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Danh sách sản phẩm</h1>
    <a asp-action="Create" class="btn btn-primary">Thêm sản phẩm</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        Chưa có sản phẩm nào.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Tên sản phẩm</th>
                    <th>Loại sản phẩm</th>
                    <th class="text-end">Giá</th>
                    <th class="text-end">Số lượng</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sanPham in Model)
                {
                    <tr>
                        <td>@sanPham.TenSanPham</td>
                        <td>@sanPham.LoaiSanPham?.TenLoai</td>
                        <td class="text-end">@sanPham.Gia.ToString("N0") ₫</td>
                        <td class="text-end">@sanPham.SoLuong</td>
                        <td>
                            @if (sanPham.TrangThai)
                            {
                                <span class="badge bg-success">Đang kinh doanh</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Ngừng kinh doanh</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@sanPham.MaSanPham" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                            <a asp-action="Edit" asp-route-id="@sanPham.MaSanPham" class="btn btn-sm btn-outline-primary">Chỉnh sửa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
