@model QuanLyCuaHangDienTu_UNETI06_TI17A2HN.Models.SanPham

@{
    ViewData["Title"] = "Thêm sản phẩm mới";
}

<!-- Họ và tên: Phạm Văn Cường - MSSV: 23103100094 -->
<h2 class="mb-4 text-primary">Thêm sản phẩm mới</h2>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="TenSanPham" class="form-label fw-bold"></label>
                    <input asp-for="TenSanPham" class="form-control" placeholder="Ví dụ: iPhone 15 Pro Max" />
                    <span asp-validation-for="TenSanPham" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ThuongHieu" class="form-label fw-bold"></label>
                    <input asp-for="ThuongHieu" class="form-control" placeholder="Ví dụ: Apple, Samsung, Sony..." />
                    <span asp-validation-for="ThuongHieu" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="MaLoai" class="form-label fw-bold"></label>
                    <select asp-for="MaLoai" asp-items="ViewBag.MaLoai" class="form-select">
                        <option value="">-- Chọn loại sản phẩm --</option>
                    </select>
                    <span asp-validation-for="MaLoai" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Gia" class="form-label fw-bold"></label>
                    <input asp-for="Gia" class="form-control" type="number" step="0.01" placeholder="Nhập giá (> 0)" />
                    <span asp-validation-for="Gia" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="SoLuong" class="form-label fw-bold"></label>
                    <input asp-for="SoLuong" class="form-control" type="number" min="0" placeholder="Số lượng tồn kho" />
                    <span asp-validation-for="SoLuong" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="ThoiGianBaoHanh" class="form-label fw-bold"></label>
                    <input asp-for="ThoiGianBaoHanh" class="form-control" type="number" min="0" placeholder="Số tháng bảo hành" />
                    <span asp-validation-for="ThoiGianBaoHanh" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="HinhAnh" class="form-label fw-bold"></label>
                    <input asp-for="HinhAnh" class="form-control" placeholder="Đường dẫn ảnh (URL hoặc /images/...)" />
                    <span asp-validation-for="HinhAnh" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="NgayNhap" class="form-label fw-bold"></label>
                    <input asp-for="NgayNhap" class="form-control" type="date" />
                    <span asp-validation-for="NgayNhap" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="MoTa" class="form-label fw-bold"></label>
                    <textarea asp-for="MoTa" class="form-control" rows="3" placeholder="Nhập mô tả chi tiết tính năng, thông số sản phẩm..."></textarea>
                    <span asp-validation-for="MoTa" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="TrangThai" class="form-check-input" type="checkbox" checked />
                        <label asp-for="TrangThai" class="form-check-label fw-bold">Kích hoạt kinh doanh sản phẩm</label>
                    </div>
                </div>

                <div class="col-12 d-flex gap-2 pt-3 border-top">
                    <!-- Nút submit đã được kích hoạt -->
                    <button type="submit" class="btn btn-primary px-4">💾 Lưu sản phẩm</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}