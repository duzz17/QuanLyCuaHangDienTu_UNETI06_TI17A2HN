@* Họ và tên: Phạm Văn Cường - MSSV: 23103100094
   Nội dung thực hiện: Giao diện chỉnh sửa và validation sản phẩm (Module 2). Tích hợp Upload ảnh (Chức năng nâng cao). *@
@model QuanLyCuaHangDienTu_UNETI06_TI17A2HN.Models.SanPham

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<h2 class="mb-4 text-primary">Chỉnh sửa sản phẩm</h2>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Khóa chính ẩn bắt buộc để cập nhật đúng bản ghi -->
            <input type="hidden" asp-for="MaSanPham" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="TenSanPham" class="form-label fw-bold"></label>
                    <input asp-for="TenSanPham" class="form-control" maxlength="200" />
                    <span asp-validation-for="TenSanPham" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ThuongHieu" class="form-label fw-bold"></label>
                    <input asp-for="ThuongHieu" class="form-control" maxlength="100" />
                    <span asp-validation-for="ThuongHieu" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="XuatXu" class="form-label fw-bold"></label>
                    <input asp-for="XuatXu" class="form-control" maxlength="100" />
                    <span asp-validation-for="XuatXu" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="MaLoai" class="form-label fw-bold"></label>
                    <select asp-for="MaLoai" asp-items="ViewBag.MaLoai" class="form-select">
                        <option value="">-- Chọn loại sản phẩm --</option>
                    </select>
                    <span asp-validation-for="MaLoai" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Gia" class="form-label fw-bold"></label>
                    <input asp-for="Gia" class="form-control" type="number" min="1" max="9999999999999999" step="1" />
                    <span asp-validation-for="Gia" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="SoLuong" class="form-label fw-bold"></label>
                    <input asp-for="SoLuong" class="form-control" type="number" min="0" max="2147483647" step="1" />
                    <span asp-validation-for="SoLuong" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="ThoiGianBaoHanh" class="form-label fw-bold"></label>
                    <input asp-for="ThoiGianBaoHanh" class="form-control" type="number" min="0" max="120" step="1" />
                    <span asp-validation-for="ThoiGianBaoHanh" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="NgayNhap" class="form-label fw-bold"></label>
                    <input asp-for="NgayNhap" class="form-control" type="date" min="2000-01-01" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="NgayNhap" class="text-danger small"></span>
                </div>

                <!-- Chức năng nâng cao: Upload ảnh sản phẩm & xem trước trực tiếp -->
                <div class="col-md-8">
                    <label class="form-label fw-bold">Hình ảnh sản phẩm (Tải file mới hoặc giữ/nhập URL)</label>
                    <div class="input-group mb-2">
                        <input type="file" name="fileAnh" id="fileAnh" class="form-control" accept="image/*" />
                        <span class="input-group-text"><i class="bi bi-upload"></i> Chọn ảnh mới</span>
                    </div>
                    <input asp-for="HinhAnh" id="inputHinhAnh" class="form-control" maxlength="500" placeholder="Hoặc dán URL http/https hoặc /images/ten-anh.jpg" />
                    <span asp-validation-for="HinhAnh" class="text-danger small"></span>
                </div>

                <div class="col-md-4 text-center">
                    <label class="form-label fw-bold small d-block">Xem trước hình ảnh</label>
                    <div class="border rounded p-1 mx-auto bg-light" style="width: 100px; height: 100px; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                        <img id="imagePreview" src="@(string.IsNullOrEmpty(Model.HinhAnh) ? "/images/no-image.png" : Model.HinhAnh)" alt="Preview" style="max-width: 100%; max-height: 100%; object-fit: contain;" onerror="this.src='https://placehold.co/100x100?text=Preview';" />
                    </div>
                </div>

                <div class="col-12">
                    <label asp-for="MoTa" class="form-label fw-bold"></label>
                    <textarea asp-for="MoTa" class="form-control" rows="3" maxlength="2000"></textarea>
                    <span asp-validation-for="MoTa" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="TrangThai" class="form-label fw-bold"></label>
                    <select asp-for="TrangThai" class="form-select">
                        <option value="@TrangThaiSanPham.DangKinhDoanh">Đang kinh doanh</option>
                        <option value="@TrangThaiSanPham.TamNgung">Tạm ngừng</option>
                        <option value="@TrangThaiSanPham.NgungKinhDoanh">Ngừng kinh doanh</option>
                    </select>
                    <span asp-validation-for="TrangThai" class="text-danger small"></span>
                </div>

                <div class="col-12 d-flex gap-2 pt-3 border-top">
                    <button type="submit" class="btn btn-primary px-4">💾 Lưu thay đổi</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const fileInput = document.getElementById('fileAnh');
        const urlInput = document.getElementById('inputHinhAnh');
        const preview = document.getElementById('imagePreview');

        if (fileInput) {
            fileInput.addEventListener('change', function(e) {
                if (this.files && this.files[0]) {
                    const reader = new FileReader();
                    reader.onload = function(ev) {
                        preview.src = ev.target.result;
                    };
                    reader.readAsDataURL(this.files[0]);
                }
            });
        }

        if (urlInput) {
            urlInput.addEventListener('input', function() {
                if (this.value && this.value.trim().length > 0) {
                    preview.src = this.value.trim();
                }
            });
        }
    </script>
}
